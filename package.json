{
  "name": "translens",
  "version": "0.1.0",
  "type": "module",
  "description": "TransLens — 沉浸式网页翻译扩展（Manifest V3，默认只显示译文）",
  "license": "MIT",
  "author": "noxiayutia",
  "homepage": "https://github.com/noxiayutia/translens#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noxiayutia/translens.git"
  },
  "bugs": {
    "url": "https://github.com/noxiayutia/translens/issues"
  },
  "keywords": [
    "chrome-extension",
    "manifest-v3",
    "translation",
    "immersive-translate",
    "typescript"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && vite build && vite build --config vite.content.config.ts && npm run verify:dist",
    "verify:dist": "node scripts/verify-dist.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "zip": "node scripts/zip-dist.mjs",
    "icons": "node scripts/make-icons.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:main": "vite build --watch",
    "dev:content": "vite build --config vite.content.config.ts --watch"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.9",
    "@types/node": "^26.5.1",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
